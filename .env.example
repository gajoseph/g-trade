# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

# Schwab API credentials (get from developer.schwab.com)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Set to 1 only during local dev if you hit SSL issues
SCHWAB_SSL_NO_VERIFY=0

# Data source: "yahoo" (no setup) or "schwab" (requires API approval)
DATA_SOURCE=yahoo

# Optional overrides
# SCHWAB_REDIRECT_URI=https://127.0.0.1
# SCHWAB_TOKEN_FILE=schwab_tokens.json
# TRADING_APP_LOG_FILE=trading_app.log

# Azure AI Document Intelligence
DOCUMENTINTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_API_KEY=your_document_intelligence_key_here

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_service_bus_key_here
SERVICE_BUS_QUEUE_NAME=document-jobs
SERVICE_BUS_OUTPUT_QUEUE_NAME=document-output
SERVICE_BUS_ERROR_QUEUE_NAME=document-errors

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_storage_key;EndpointSuffix=core.windows.net
BLOB_INPUT_CONTAINER=document-input
BLOB_OUTPUT_CONTAINER=document-output

# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your_cosmos_key_here
COSMOS_DATABASE_NAME=document-processing
COSMOS_CONTAINER_NAME=document-jobs
