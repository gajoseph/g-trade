# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

# Schwab API credentials (get from developer.schwab.com)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# Set to 1 only during local dev if you hit SSL issues
SCHWAB_SSL_NO_VERIFY=0

# Data source: "yahoo" (no setup) or "schwab" (requires API approval)
DATA_SOURCE=yahoo

# Optional overrides
# SCHWAB_REDIRECT_URI=https://127.0.0.1
# SCHWAB_TOKEN_FILE=schwab_tokens.json
# TRADING_APP_LOG_FILE=trading_app.log
